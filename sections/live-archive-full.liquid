{% comment %}
  Full LIVE_ARCHIVE database — every article in the "live-archive" blog.
  Merchant maintains this by adding/removing blog articles, no theme edits.
{% endcomment %}
<div class="cry-container" style="padding-block:48px;">
  <div class="mtitle">LIVE_ARCHIVE <span class="jp-gloss">過去の公演</span><span class="meta">DATABASE</span></div>

  {% assign archive_blog = blogs['live-archive'] %}
  <div class="cry-grid cry-grid--3">
    {% if archive_blog and archive_blog.articles.size > 0 %}
      {% for article in archive_blog.articles %}
        <a href="{{ article.url }}" class="mbox flat" style="display:block;text-decoration:none;">
          <div class="shot" style="aspect-ratio:4/5;margin-bottom:12px;">
            {% if article.image %}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}
            <figcaption>EVENT_{{ forloop.index | prepend: '000' | slice: -3, 3 }}</figcaption>
          </div>
          <div class="v" style="font-size:14px;">{{ article.title }}</div>
          <div class="k" style="margin-top:4px;">{{ article.published_at | date: '%m.%d.%Y' }}</div>
          {% if article.tags.size > 0 %}
            <div class="k" style="margin-top:4px;color:var(--ink-faint);">{{ article.tags | join: ' · ' }}</div>
          {% endif %}
        </a>
      {% endfor %}
    {% else %}
      {% comment %} Demo content until a "live-archive" blog exists — swap for real articles. {% endcomment %}
      {% assign demo = 'tour-jp-01.jpg|SEKAI//DIVIDE — NAGOYA JAMMIN|02.11.2026,tour-jp-02.jpg|SEKAI//DIVIDE — OSAKA Yogibo META VALLEY|02.13.2026,tour-jp-03.jpg|SEKAI//DIVIDE — TOKYO Spotify O-West|02.22.2026,tour-jp-04.jpg|LIGHT FADE TOUR — TOKYO clubasia|08.19.2026' | split: ',' %}
      {% for entry in demo %}
        {% assign parts = entry | split: '|' %}
        <div class="mbox flat">
          <div class="shot" style="aspect-ratio:4/5;margin-bottom:12px;">
            <img src="{{ parts[0] | asset_url }}" alt="" loading="lazy">
            <figcaption>EVENT_{{ forloop.index | prepend: '000' | slice: -3, 3 }}</figcaption>
          </div>
          <div class="v" style="font-size:14px;">{{ parts[1] }}</div>
          <div class="k" style="margin-top:4px;">{{ parts[2] }}</div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{ "name": "Live archive — Full", "settings": [] }
{% endschema %}
