{% comment %} Discoverable, not a summary — one fragment only. Per brief §12. {% endcomment %}
<section class="cry-section cry-container" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;">
  <div class="mbox">
    <div class="mtitle">
      SYSTEM <span class="jp-gloss">システム</span>
      <span class="meta">FRAGMENT // {{ section.settings.fragment_id | default: '0X' }}</span>
    </div>
    <p style="font-family:var(--ui);color:var(--ink);font-size:15px;text-shadow:1px 1px 0 #000;">
      {{ section.settings.fragment_text }}
    </p>
    <a href="{{ section.settings.system_page_url | default: '/pages/system' }}" class="btn amber" style="margin-top:12px;">ENTER CRY OS</a>
  </div>
  <div class="shot" style="aspect-ratio:16/9;">
    <img src="{{ 'texture-halftone.jpg' | asset_url }}" alt="" loading="lazy">
  </div>
</section>

<style>
  @media (max-width: 768px) {
    section.cry-section[style] { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "System — Teaser",
  "settings": [
    { "type": "url", "id": "system_page_url", "label": "SYSTEM page URL" },
    { "type": "text", "id": "fragment_id", "label": "Fragment ID", "default": "0X" },
    { "type": "textarea", "id": "fragment_text", "label": "Fragment text" }
  ],
  "presets": [{ "name": "System — Teaser" }]
}
{% endschema %}
