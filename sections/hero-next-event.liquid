{% liquid
  comment
    Auto-pulls the soonest upcoming show from the "event" metaobject
    type (filtered to event_date >= today) — the SAME single source
    the homepage teaser and Live page list also read from, so an event
    is only ever entered once. Falls back to a manually-set block if
    no metaobject entry qualifies yet, so this never breaks before
    that's set up.
  endcomment
  assign today_num = 'now' | date: '%Y%m%d' | plus: 0
  assign all_events = shop.metaobjects['event'].values
  assign auto_event = nil
  assign auto_event_num = 999999999
  for event in all_events
    assign ev_date = event.event_date.value
    if ev_date
      assign d = ev_date | date: '%Y%m%d' | plus: 0
      if d >= today_num and d < auto_event_num
        assign auto_event = event
        assign auto_event_num = d
      endif
    endif
  endfor
  assign fallback_event = section.blocks.first
%}

<div class="cry-hero" data-boot-sequence>
  <div class="cry-hero__media">
    {% if section.settings.background_video != blank %}
      {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    {% elsif section.settings.background_image %}
      {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high' }}
    {% elsif section.settings.enable_rotation %}
      {% comment %}
        Cycling hero — 7 graded stills, pure-CSS slow crossfade (no JS,
        respects prefers-reduced-motion by freezing on frame 1). Each photo
        fades in over 3s, holds for 4s, then dissolves directly into the
        next one over 3s — see cry-os.css ".cry-hero__rotation". Order is a
        deliberate arc: mystery/world (1-3) → human payoff (4) → live energy
        build (5-6) → intimate close (7), looping back into the quiet opener.
      {% endcomment %}
      <div class="cry-hero__rotation">
        <img src="{{ 'hero-rotation-1.jpg' | asset_url }}" alt="" loading="eager" fetchpriority="high">
        <img src="{{ 'hero-rotation-2.jpg' | asset_url }}" alt="" loading="lazy">
        <img src="{{ 'hero-rotation-3.jpg' | asset_url }}" alt="" loading="lazy">
        <img src="{{ 'hero-rotation-4.jpg' | asset_url }}" alt="" loading="lazy">
        <img src="{{ 'hero-rotation-5.jpg' | asset_url }}" alt="" loading="lazy">
        <img src="{{ 'hero-rotation-6.jpg' | asset_url }}" alt="" loading="lazy">
        <img src="{{ 'hero-rotation-7.jpg' | asset_url }}" alt="" loading="lazy">
      </div>
    {% else %}
      <img src="{{ 'hero-defiance.jpg' | asset_url }}" alt="" loading="eager" fetchpriority="high">
    {% endif %}
  </div>

  <div class="cry-hero__body cry-container">
    <div data-boot-line style="opacity:0;">
      <div class="cry-boot-line" style="font-family:var(--tel);font-size:12px;color:var(--ink-faint);letter-spacing:.1em;">&gt; mounting /kala/session ......... <span class="status ok">OK</span></div>
    </div>
    <div data-boot-line style="opacity:0;">
      <div class="cry-boot-line" style="font-family:var(--tel);font-size:12px;color:var(--ink-faint);letter-spacing:.1em;">&gt; decrypting identity ............ <span class="status ok">OK</span></div>
    </div>

    <h1 class="cry-hero__title" data-boot-line style="opacity:0;">{{ shop.name | default: 'KALA' }}</h1>

    {% if auto_event or fallback_event %}
      {% comment %}
        Invisible same-structure spacer — the real panel is now
        absolutely positioned elsewhere, but the title block still
        needs to reserve this height to sit where it used to.
      {% endcomment %}
      <div class="mbox event-panel event-panel--spacer" aria-hidden="true">
        <div class="mtitle">NEXT EVENT <span class="jp-gloss">次のイベント</span><span class="meta">X</span></div>
        <div class="tour">X</div>
        <div class="row"><span class="k">DATE</span><span class="v">X</span></div>
        <div class="row"><span class="k">LOCATION</span><span class="v">X</span></div>
        <div class="row"><span class="k">VENUE</span><span class="v">X</span></div>
        <div class="row" style="border-bottom:none;padding-top:12px;"><span class="status ok">X</span></div>
        <a href="#" class="btn solid" style="width:100%;margin-top:12px;" tabindex="-1">X</a>
      </div>
    {% endif %}
  </div>

  {% if auto_event %}
    <div class="mbox event-panel" data-boot-line style="opacity:0;">
      <div class="mtitle">
        NEXT EVENT <span class="jp-gloss">次のイベント</span>
        <span class="meta">{{ auto_event.tour_name.value | upcase }}</span>
      </div>
      <div class="tour">{{ auto_event.tour_name.value }}</div>
      <div class="row">
        <span class="k">DATE</span><span class="v">{{ auto_event.event_date.value | date: '%m.%d.%Y' }}</span>
      </div>
      <div class="row">
        <span class="k">LOCATION</span><span class="v">{{ auto_event.city.value }} / {{ auto_event.country.value }}</span>
      </div>
      <div class="row">
        <span class="k">VENUE</span><span class="v">{{ auto_event.venue.value }}</span>
      </div>
      <div class="row" style="border-bottom:none;padding-top:12px;">
        <span class="status {{ auto_event.status.value | default: 'ok' }}">{{ auto_event.status_label.value | default: 'TICKETS AVAILABLE' }}</span>
      </div>
      <a href="{{ auto_event.ticket_url.value | default: '#' }}" class="btn solid" style="width:100%;margin-top:12px;">GET TICKETS</a>
    </div>
  {% elsif fallback_event %}
    <div class="mbox event-panel" data-boot-line style="opacity:0;">
      <div class="mtitle">
        NEXT EVENT <span class="jp-gloss">次のイベント</span>
        <span class="meta">{{ fallback_event.settings.event_id | default: 'EVENT_001' }}</span>
      </div>
      <div class="tour">{{ fallback_event.settings.tour_name }}</div>
      <div class="row">
        <span class="k">DATE</span><span class="v">{{ fallback_event.settings.date }}</span>
      </div>
      <div class="row">
        <span class="k">LOCATION</span><span class="v">{{ fallback_event.settings.city }} / {{ fallback_event.settings.country }}</span>
      </div>
      <div class="row">
        <span class="k">VENUE</span><span class="v">{{ fallback_event.settings.venue }}</span>
      </div>
      <div class="row" style="border-bottom:none;padding-top:12px;">
        <span class="status {{ fallback_event.settings.status | default: 'ok' }}">{{ fallback_event.settings.status_label | default: 'TICKETS AVAILABLE' }}</span>
      </div>
      <a href="{{ fallback_event.settings.ticket_url | default: '#' }}" class="btn solid" style="width:100%;margin-top:12px;">GET TICKETS</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero — Next Event",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image (overrides rotation)" },
    { "type": "video", "id": "background_video", "label": "Background video (overrides image + rotation)" },
    { "type": "checkbox", "id": "enable_rotation", "label": "Cycle through hero photo rotation when no image/video is set", "default": true }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "event_id", "label": "Event ID", "default": "EVENT_001" },
        { "type": "text", "id": "tour_name", "label": "Tour / event name" },
        { "type": "text", "id": "date", "label": "Date", "info": "e.g. 08.19.2026" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "country", "label": "Country" },
        { "type": "text", "id": "venue", "label": "Venue" },
        {
          "type": "select", "id": "status", "label": "Status",
          "options": [
            { "value": "ok", "label": "On sale" },
            { "value": "pending", "label": "Limited / almost sold out" },
            { "value": "err", "label": "Sold out" }
          ],
          "default": "ok"
        },
        { "type": "text", "id": "status_label", "label": "Status label", "default": "TICKETS AVAILABLE" },
        { "type": "url", "id": "ticket_url", "label": "Ticket link" }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [{ "name": "Hero — Next Event", "blocks": [{ "type": "event" }] }]
}
{% endschema %}
