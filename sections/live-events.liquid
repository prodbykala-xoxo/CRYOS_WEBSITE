<section class="cry-container" style="padding-block:48px;">
  <div class="mtitle">UPCOMING <span class="jp-gloss">今後の公演</span></div>

  <div>
    {% for block in section.blocks %}
      <div class="event-row">
        <div class="event-row__id">{{ block.settings.event_id }}</div>
        <div class="event-row__date">{{ block.settings.date }}</div>
        <div class="event-row__icon-slot">
          {% if block.settings.promo_icon %}
            <img class="event-row__icon" src="{{ block.settings.promo_icon | image_url: width: 80 }}" alt="" width="28" height="28">
          {% endif %}
        </div>
        <div class="event-row__place">
          {{ block.settings.tour_name }} — {{ block.settings.city }} / {{ block.settings.country }}
          <span class="sub">{{ block.settings.venue }}{% if block.settings.support != blank %} · w/ {{ block.settings.support }}{% endif %}</span>
        </div>
        <div class="status {{ block.settings.status | default: 'ok' }}">{{ block.settings.status_label | default: 'TICKETS AVAILABLE' }}</div>
        <a href="{{ block.settings.ticket_url | default: '#' }}" class="btn solid" style="padding:.6em 1.2em;">GET TICKETS</a>
      </div>
    {% else %}
      <p class="status pending">NO SCHEDULED TRANSMISSIONS</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Live — Events",
  "settings": [],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "event_id", "label": "Event ID", "default": "EVENT_001" },
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "text", "id": "tour_name", "label": "Tour / event name" },
        { "type": "image_picker", "id": "promo_icon", "label": "Promo icon (optional)", "info": "Small logo/badge shown next to this entry, e.g. a sub-brand mark for a specific event series." },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "country", "label": "Country" },
        { "type": "text", "id": "venue", "label": "Venue" },
        { "type": "text", "id": "support", "label": "Supporting artists" },
        {
          "type": "select", "id": "status", "label": "Status",
          "options": [
            { "value": "ok", "label": "On sale" },
            { "value": "pending", "label": "Limited" },
            { "value": "err", "label": "Sold out" }
          ],
          "default": "ok"
        },
        { "type": "text", "id": "status_label", "label": "Status label", "default": "TICKETS AVAILABLE" },
        { "type": "url", "id": "ticket_url", "label": "Ticket link" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Live — Events" }]
}
{% endschema %}
