<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-cry-os="v2.6">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{{ 'logo-square-black.png' | asset_url }}">

  {{ content_for_header }}

  {{ 'cry-os.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;900&family=Space+Mono:wght@400;700&family=Share+Tech+Mono&family=Press+Start+2P&family=Zen+Kaku+Gothic+New:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body class="screen">

  <div class="cry-sigil" aria-hidden="true"></div>
  <div class="vig" aria-hidden="true"></div>

  <div class="cry-bar cry-bar--top">
    <div class="cry-bar__left">
      <span class="dot" aria-hidden="true"></span>
      <span>CRY OS v2.6 · SESSION LIVE</span>
      <span>{{ template.name | default: 'index' | upcase }}</span>
    </div>
    <div class="cry-bar__right">
      <span>{{ shop.name | upcase }}</span>
      <span>{{ 'now' | date: "%Y.%m.%d %H:%M" }}</span>
    </div>
  </div>

  {% section 'header' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'cart-drawer' %}

  <div class="cry-mobile-bar">
    <div class="cry-mobile-bar__row">
      <a href="{{ pages.live.url | default: '/pages/live' }}">Tickets</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="#" data-cart-open>Cart ({{ cart.item_count }})</a>
    </div>
  </div>

  <div class="cry-bar cry-bar--bottom">
    <div class="cry-bar__left">
      <span>{{ shop.name | upcase }} / CRY OS</span>
    </div>
    <div class="cry-bar__right">
      <span>P.01</span>
    </div>
  </div>

  {{ 'cry-os.js' | asset_url | script_tag }}
</body>
</html>
