/* ==========================================================================
   CRY OS — KALA design system
   Tokens/components per /docs/cry-os-one-sheet.md — the authoritative
   client reference. Do not add hues outside the defined palette.
   ========================================================================== */

:root {
  /* surfaces */
  --void: #08090b;
  --panel: #101215;
  --sunk: #0b0d0f;
  --line: #20242a;
  --line-hot: #2e343c;

  /* type */
  --ink: #e6ecf2;
  --ink-dim: #8b959f;
  --ink-faint: #4a525b;

  /* signal */
  --sig: #8fb3b3;
  --sig-hot: #bfe0dd;

  /* status */
  --alert: #d0552f;
  --amber: #c98a34;
  --live: #4bbf9a;

  /* JRPG menu layer */
  --edge: #9fbdd8;
  --menu-hi: #1b3f7a;
  --menu-lo: #050b1c;

  /* fonts */
  --ui: "Space Mono", ui-monospace, monospace;
  --tel: "Share Tech Mono", ui-monospace, monospace;
  --disp: "Cinzel", serif;
  --px: "Press Start 2P", monospace;
  --jp: "Zen Kaku Gothic New", "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;

  --bar-h: 44px;
  --dur-fast: 120ms;
  --dur-base: 220ms;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
}

/* -------------------------------------------------------------------------
   Base
   ------------------------------------------------------------------------- */

* { box-sizing: border-box; }
html { background: var(--void); color-scheme: dark; }

body {
  margin: 0;
  background: var(--void);
  color: var(--ink-dim);
  font-family: var(--ui);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  padding-top: var(--bar-h);
  padding-bottom: var(--bar-h);
}

:lang(ja), .jp {
  font-family: var(--jp);
  line-height: 1.9;
  letter-spacing: 0.02em;
}

h1, h2, h3, h4 {
  margin: 0;
  color: var(--ink);
  font-family: var(--disp);
  font-weight: 600;
  line-height: 1.1;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000;
}

a { color: inherit; text-decoration: none; }
img, video { max-width: 100%; display: block; }
button { font-family: inherit; }

.cry-container {
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 24px;
}
@media (max-width: 768px) { .cry-container { padding-inline: 16px; } }

/* -------------------------------------------------------------------------
   Screen chrome: scanline, vignette, status bars
   ------------------------------------------------------------------------- */

.screen { position: relative; }
.screen::after {
  content: "";
  position: absolute; inset: 0; pointer-events: none; z-index: 60;
  background: repeating-linear-gradient(0deg,
    rgba(0,0,0,.22) 0px, rgba(0,0,0,.22) 1px, transparent 1px, transparent 3px);
  mix-blend-mode: multiply; opacity: .55;
}
@media (prefers-reduced-motion: reduce) { .screen::after { opacity: .25; } }

.vig {
  position: absolute; inset: 0; z-index: 55; pointer-events: none;
  background: radial-gradient(120% 90% at 50% 45%, transparent 40%, rgba(0,0,0,.55) 100%);
}

/* Sigil watermark — the alt logo, massive and almost invisible, fixed to
   the viewport like a mark burned into the OS substrate rather than page
   decoration. Sits above the void but well below content/panels, so it
   only reads in the negative space around them.
   Sized off viewport HEIGHT (not vmax) so the whole square mark stays in
   frame on wide/landscape screens — vmax locks both dimensions to the
   wider axis, which on a landscape viewport left only a thin sliver of
   the logo's vertical extent visible at once. */
.cry-sigil {
  position: fixed; inset: 0; z-index: 2; pointer-events: none;
  background-image: url("{{ 'logo-square-white.png' | asset_url }}");
  background-repeat: no-repeat;
  background-position: center;
  background-size: auto 120vh;
  opacity: .02;
}

.dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--live);
  box-shadow: 0 0 8px var(--live); display: inline-block;
  animation: cry-pulse 2.4s ease-in-out infinite;
}
@keyframes cry-pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }
@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }

.cry-bar {
  position: fixed; inset-inline: 0; height: var(--bar-h); z-index: 70;
  display: flex; align-items: center; justify-content: space-between;
  padding-inline: 20px;
  background: #05070a;
  font-family: var(--tel);
  font-size: 12px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.cry-bar--top { top: 0; border-bottom: 1px solid var(--line); }
.cry-bar--bottom { bottom: 0; border-top: 1px solid var(--line); }
.cry-bar__left, .cry-bar__right { display: flex; align-items: center; gap: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
@media (max-width: 640px) {
  .cry-bar { font-size: 10px; letter-spacing: .1em; padding-inline: 12px; }
}

/* -------------------------------------------------------------------------
   Menu box — the signature container
   ------------------------------------------------------------------------- */

.mbox {
  position: relative;
  border: 2px solid var(--edge);
  border-radius: 5px;
  background: linear-gradient(180deg, rgba(27,63,122,.90) 0%, rgba(10,24,58,.93) 48%, rgba(5,11,28,.96) 100%);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.13),
              inset 0 3px 26px rgba(120,180,255,.12),
              0 0 0 1px #000, 0 12px 34px rgba(0,0,0,.65);
  padding: 20px 24px;
  overflow: hidden;
}
.mbox.flat {
  background: linear-gradient(180deg, rgba(14,20,30,.94), rgba(6,9,14,.97));
  border-color: #3d4a58;
}
.mbox.glass {
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.mtitle {
  font-family: var(--px);
  font-size: 11px;
  letter-spacing: .10em;
  color: var(--sig-hot);
  text-shadow: 2px 2px 0 #000;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.mtitle .jp-gloss { font-family: var(--jp); font-size: 13px; letter-spacing: 0; color: var(--ink-dim); text-shadow: none; }
.mtitle .meta { margin-left: auto; font-family: var(--tel); font-size: 10px; color: var(--ink-faint); letter-spacing: .1em; }

/* Menu row with amber cursor */
.row {
  display: flex; align-items: baseline; gap: 14px;
  padding: 8px 0 8px 26px; position: relative;
  border-bottom: 1px solid rgba(159,189,216,.16);
}
.row:last-child { border-bottom: none; }
.row::before {
  content: ""; position: absolute; left: 4px; top: 14px;
  border-left: 9px solid var(--amber);
  border-top: 6px solid transparent; border-bottom: 6px solid transparent;
  filter: drop-shadow(1px 1px 0 #000);
}
.row .k { font-family: var(--tel); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--sig); flex: none; min-width: 8em; }
.row .v { font-family: var(--ui); color: var(--ink); text-shadow: 1px 1px 0 #000; }

/* Materia orb */
.orb {
  width: 58px; height: 58px; border-radius: 50%; flex: 0 0 auto;
  background: radial-gradient(circle at 33% 27%, #fff 0%, var(--c, var(--sig)) 26%, #0a1526 78%, #03060c 100%);
  box-shadow: 0 0 16px var(--c, var(--sig)), 0 0 34px rgba(0,0,0,.8), inset 0 -6px 12px rgba(0,0,0,.6);
}

/* Stat gauge */
.gauge { flex: 1; height: 14px; background: #060a12; border: 1px solid #33445c; box-shadow: inset 0 1px 3px rgba(0,0,0,.9); }
.gauge i { display: block; height: 100%; background: linear-gradient(180deg,#d7f2ee 0%, var(--sig-hot) 34%, #4d8f92 100%); box-shadow: 0 0 10px rgba(191,224,221,.45); }
.gauge.amb i { background: linear-gradient(180deg,#f4dfae 0%, var(--amber) 34%, #7d5518 100%); }

/* Image frame */
.shot {
  position: relative; overflow: hidden;
  border: 2px solid var(--edge); border-radius: 4px;
  box-shadow: 0 0 0 1px #000, 0 10px 30px rgba(0,0,0,.7);
  background: #05070c;
}
.shot img, .shot video { width: 100%; height: 100%; object-fit: cover; display: block; }
.shot figcaption {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 9px 12px;
  background: linear-gradient(180deg, transparent, rgba(3,5,10,.94));
  font-family: var(--tel); font-size: 12.5px; letter-spacing: .13em; color: var(--sig-hot);
}
.shot figcaption .scrap__title { display: block; }
.shot figcaption .scrap__note {
  display: block; margin-top: 4px;
  font-family: var(--ui); font-size: 11.5px; letter-spacing: normal; text-transform: none;
  color: var(--ink-dim); font-style: italic;
}
.shot figcaption .scrap__note::before { content: "// "; color: var(--ink-faint); font-style: normal; }

/* Award / callout box — max one per panel */
.award {
  border: 1px solid var(--amber); border-radius: 4px;
  background: linear-gradient(180deg, rgba(201,138,52,.20), rgba(201,138,52,.05));
  padding: 14px 16px;
}
.award .title { font-family: var(--px); font-size: 10px; color: #fbe3b6; text-shadow: 1px 1px 0 #000; margin-bottom: 8px; letter-spacing: .08em; }
.award .body { font-family: var(--ui); font-size: 13px; color: var(--ink-dim); }

/* Status word */
.status { font-family: var(--tel); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
.status.ok { color: var(--live); }
.status.pending { color: var(--amber); }
.status.err { color: var(--alert); }

/* -------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .5em;
  padding: .9em 1.7em;
  font-family: var(--tel); font-size: 12px; letter-spacing: .14em; text-transform: uppercase;
  border: 1px solid var(--sig); border-radius: 3px;
  background: transparent; color: var(--sig-hot);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.btn:hover { background: var(--sig); color: var(--void); }
.btn.solid { background: var(--sig); color: var(--void); }
.btn.solid:hover { background: var(--sig-hot); border-color: var(--sig-hot); }
.btn.amber { border-color: var(--amber); color: var(--amber); }
.btn.amber:hover { background: var(--amber); color: var(--void); }
.btn[disabled] { opacity: .4; cursor: not-allowed; }

/* -------------------------------------------------------------------------
   Article body — live-archive write-ups (rich text from the blog editor)
   ------------------------------------------------------------------------- */

.article-body { font-family: var(--ui); color: var(--ink); line-height: 1.75; font-size: 15px; }
.article-body p { margin-bottom: 1.4em; }
.article-body h2, .article-body h3 {
  font-family: var(--disp); color: var(--ink); text-shadow: 1px 1px 0 #000;
  margin: 1.6em 0 .6em;
}
.article-body a { color: var(--sig-hot); text-decoration: underline; text-underline-offset: 3px; }
.article-body ul, .article-body ol { margin: 0 0 1.4em 1.4em; }
.article-body img {
  display: block; width: 100%; height: auto; margin: 1.6em 0;
  border: 2px solid var(--edge); border-radius: 4px;
  box-shadow: 0 0 0 1px #000, 0 10px 30px rgba(0,0,0,.7);
}
.article-body blockquote {
  border-left: 2px solid var(--sig); padding-left: 16px; margin: 1.6em 0;
  color: var(--ink-dim); font-style: italic;
}

/* -------------------------------------------------------------------------
   Header
   ------------------------------------------------------------------------- */

.cry-header {
  position: sticky; top: var(--bar-h); z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 24px;
  background: rgba(8,9,11,.85);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.cry-header__logo { font-family: var(--disp); font-size: 20px; color: var(--ink); letter-spacing: .04em; text-shadow: 2px 2px 0 #000; }
.cry-header__nav { display: flex; gap: 28px; font-family: var(--tel); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
.cry-header__nav a { color: var(--ink-dim); transition: color var(--dur-fast); }
.cry-header__nav a:hover, .cry-header__nav a[aria-current="page"] { color: var(--sig-hot); }
.cry-header__cart {
  font-family: var(--tel); font-size: 12px; letter-spacing: .1em; color: var(--ink);
  background: none; border: 1px solid var(--line-hot); padding: .6em 1em; cursor: pointer;
}
.cry-header__cart:hover { border-color: var(--sig); color: var(--sig-hot); }
@media (max-width: 768px) { .cry-header__nav { display: none; } }

/* Mobile sticky quick-access — tickets/merch one tap away */
.cry-mobile-bar {
  display: none;
  position: fixed; bottom: var(--bar-h); inset-inline: 0; z-index: 65;
  border-top: 1px solid var(--line);
  background: rgba(8,9,11,.94);
}
.cry-mobile-bar__row { display: flex; }
.cry-mobile-bar a {
  flex: 1; text-align: center; padding: .9em 0;
  font-family: var(--tel); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink); border-right: 1px solid var(--line);
}
.cry-mobile-bar a:last-child { border-right: none; }
@media (max-width: 768px) {
  .cry-mobile-bar { display: block; }
  body { padding-bottom: calc(var(--bar-h) * 2); }
}

/* -------------------------------------------------------------------------
   Ticker
   ------------------------------------------------------------------------- */

.cry-ticker { overflow: hidden; border-bottom: 1px solid var(--line); background: var(--panel); padding-block: 8px; }
.cry-ticker__track {
  display: flex; width: max-content; gap: 48px;
  animation: cry-ticker-scroll 42s linear infinite;
  font-family: var(--tel); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-dim);
  white-space: nowrap;
}
.cry-ticker:hover .cry-ticker__track { animation-play-state: paused; }
.cry-ticker__item { display: flex; align-items: center; gap: 48px; }
.cry-ticker__item .accent { color: var(--sig-hot); }
@keyframes cry-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .cry-ticker__track { animation: none; } }

/* -------------------------------------------------------------------------
   Hero / next event
   ------------------------------------------------------------------------- */

.cry-hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; background: var(--void); }
.cry-hero__media { position: absolute; inset: 0; z-index: 0; }
.cry-hero__media img, .cry-hero__media video { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85) contrast(1.05); }
.cry-hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,9,11,.2) 0%, rgba(8,9,11,.92) 100%); }

/* Cycling hero rotation — 7 stills in a slow true crossfade: each photo
   fades in over 3s, holds for 4s, then spends the next 3s dissolving
   directly into the following photo (they overlap, both partially
   visible, rather than cutting through black). One shared 49s timeline,
   images spaced 7s apart (3s fade + 4s hold = 7s, so image N's fade-out
   exactly overlaps image N+1's fade-in). */
.cry-hero__rotation { position: absolute; inset: 0; }
.cry-hero__rotation img {
  position: absolute; inset: 0;
  opacity: 0;
  animation: cry-hero-cycle 49s infinite;
}
.cry-hero__rotation img:nth-child(1) { animation-delay: 0s; }
.cry-hero__rotation img:nth-child(2) { animation-delay: 7s; }
.cry-hero__rotation img:nth-child(3) { animation-delay: 14s; }
.cry-hero__rotation img:nth-child(4) { animation-delay: 21s; }
.cry-hero__rotation img:nth-child(5) { animation-delay: 28s; }
.cry-hero__rotation img:nth-child(6) { animation-delay: 35s; }
.cry-hero__rotation img:nth-child(7) { animation-delay: 42s; }
@keyframes cry-hero-cycle {
  0%     { opacity: 0; }
  6.12%  { opacity: 1; }  /* 3s fade-in complete */
  14.29% { opacity: 1; }  /* 7s: hold ends, next image begins fading in here too */
  20.41% { opacity: 0; }  /* 10s: fade-out complete */
  100%   { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .cry-hero__rotation img { animation: none; }
  .cry-hero__rotation img:first-child { opacity: 1; }
}
.cry-hero__body { position: relative; z-index: 2; width: 100%; padding: 48px 24px; display: flex; flex-direction: column; gap: 24px; }
.cry-hero__title { font-size: clamp(48px, 10vw, 88px); letter-spacing: .01em; }

.event-panel {
  position: absolute; z-index: 2; top: 50%; right: 24px; transform: translateY(-50%);
  width: min(400px, 100%);
}
@media (max-width: 640px) {
  .event-panel { position: static; transform: none; width: 100%; margin: 24px 0 0; }
}
.event-panel .tour { font-family: var(--disp); font-size: 22px; color: var(--ink); text-shadow: 1px 1px 0 #000; margin-bottom: 10px; }

/* -------------------------------------------------------------------------
   Section teasers
   ------------------------------------------------------------------------- */

.cry-section { padding-block: 64px; border-top: 1px solid var(--line); position: relative; }
.cry-section__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 32px; gap: 16px; flex-wrap: wrap; }
.cry-section__title { font-size: 32px; }
.cry-section--music { padding-block: 40px; } /* deliberately smaller than LIVE/SHOP/MEDIA */

.cry-grid { display: grid; gap: 20px; }
.cry-grid--3 { grid-template-columns: repeat(3, 1fr); }
.cry-grid--4 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 1024px) { .cry-grid--3, .cry-grid--4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .cry-grid--3, .cry-grid--4 { grid-template-columns: 1fr; } }

/* -------------------------------------------------------------------------
   Event log row (LIVE page)
   ------------------------------------------------------------------------- */

.event-row {
  display: grid; grid-template-columns: 90px 110px 1.4fr auto auto;
  align-items: center; gap: 16px; padding: 16px 0;
  border-bottom: 1px solid var(--line);
}
.event-row__id { font-family: var(--tel); font-size: 10px; color: var(--ink-faint); letter-spacing: .1em; }
.event-row__date { font-family: var(--tel); color: var(--ink); letter-spacing: .06em; }
.event-row__place { position: relative; color: var(--ink); font-family: var(--ui); }
.event-row__place .sub { color: var(--ink-dim); font-size: 12px; display: block; margin-top: 2px; }
.event-row__icon {
  display: block; position: absolute; left: -58px; top: 50%; transform: translateY(-50%);
  width: 40px; height: 40px; object-fit: contain; padding: 4px;
  border: 1px solid var(--edge); border-radius: 4px; background: #05070c;
}
@media (max-width: 768px) {
  .event-row { grid-template-columns: 1fr; gap: 6px; }
  .event-row__icon { position: static; transform: none; margin-bottom: 6px; }
}

/* -------------------------------------------------------------------------
   Product card — stays inside the CRY OS dark system (shot + flat mbox),
   large clean photography per the dropdead.world pattern but no separate
   light "shop mode": restraint/no-new-hues rules still apply while shopping.
   ------------------------------------------------------------------------- */

.product-card { position: relative; }
.product-card__tag {
  position: absolute; top: 10px; left: 10px; z-index: 2;
  font-family: var(--tel); font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  padding: .35em .7em; border: 1px solid var(--amber); color: var(--amber); background: rgba(8,9,11,.75);
}
.product-card__tag.sold-out { border-color: var(--ink-faint); color: var(--ink-faint); }
.product-card__media { aspect-ratio: 4/5; }
.product-card__info { margin-top: 10px; padding: 14px 16px; }
.product-card__name { font-family: var(--ui); font-size: 13px; color: var(--ink); text-shadow: 1px 1px 0 #000; }
.product-card__price { font-family: var(--tel); font-size: 12px; color: var(--sig-hot); margin-top: 4px; }

.size-pills { display: flex; gap: 8px; flex-wrap: wrap; }
.size-pill {
  min-width: 2.6em; padding: .6em .8em; text-align: center;
  border: 1px solid var(--line-hot); font-family: var(--tel); font-size: 12px;
  color: var(--ink); background: transparent; cursor: pointer;
}
.size-pill[aria-pressed="true"] { background: var(--sig); border-color: var(--sig); color: var(--void); }
.size-pill:disabled { color: var(--ink-faint); border-color: var(--ink-faint); cursor: not-allowed; text-decoration: line-through; }

/* -------------------------------------------------------------------------
   Cart drawer
   ------------------------------------------------------------------------- */

.cart-drawer {
  position: fixed; top: var(--bar-h); right: 0; bottom: var(--bar-h);
  width: min(420px, 100vw);
  transform: translateX(100%);
  transition: transform var(--dur-base) var(--ease);
  z-index: 90; display: flex; flex-direction: column; padding: 20px;
  background: linear-gradient(180deg, rgba(27,63,122,.94) 0%, rgba(5,11,28,.97) 60%);
  backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  border-left: 2px solid var(--edge);
  overflow-y: auto;
}
.cart-drawer[data-open="true"] { transform: translateX(0); }
.cart-overlay {
  position: fixed; inset: 0; background: rgba(8,9,11,.6);
  opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease); z-index: 89;
}
.cart-overlay[data-open="true"] { opacity: 1; pointer-events: auto; }

.cry-footer {
  border-top: 1px solid var(--line);
  padding: 48px 24px;
  font-family: var(--tel);
  font-size: 12px;
  color: var(--ink-faint);
  letter-spacing: .06em;
}
